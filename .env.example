# Copy to .env.local and fill in.
# Comma-separated CODE:label pairs. Keep the master code first.
# Codes are matched case-insensitively (and trimmed).
YAI_ACCESS_CODES="YAI2026:Master code"

# Optional: secret used to sign the auth cookie. Generate with: openssl rand -hex 32
YAI_COOKIE_SECRET="change-me-in-production-please-32-chars-min"
