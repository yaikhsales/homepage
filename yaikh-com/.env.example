# yaikh-com — environment template.
# Copy to `.env.local` (git-ignored) and fill in real values.
#   cp .env.example .env.local

# ─── ABA PayWay (payments on /subscribe) ────────────────────────────
# Sandbox creds for merchant ec476637 live in ABA/payway-tester/.env.
# For production: request domain whitelisting from ABA, then swap in the
# production merchant id + API key and set PAYWAY_BASE_URL to the prod host.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh
# Prod:    https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# ABA transaction lifetime and matching browser status-check ceiling, in minutes.
PAYWAY_TRANSACTION_LIFETIME_MINUTES=5

# Fixed USD-to-KHR display and ABA/KHQR charge rate for cloud plans.
SUBSCRIPTION_KHR_PER_USD=4100
# Public display copy of the same fixed rate for the client-rendered homepage.
NEXT_PUBLIC_SUBSCRIPTION_KHR_PER_USD=4100
# Optional — only needed once Refund / pre-auth / payout flows are wired
# (RSA public key that encrypts merchant_auth). See ABA/payway-tester/.env.
#PAYWAY_RSA_PUBLIC_KEY=

# ─── Database ───────────────────────────────────────────────────────
MONGO_URL=

# Subscription email verification — Microsoft 365 / Outlook via Microsoft Graph.
# Copy this file to `.env.local`; do not commit it or paste the secret into chat.
# In Microsoft Entra, give the app Microsoft Graph APPLICATION permission Mail.Send,
# grant admin consent, then set these values from App registrations > Overview / Certificates & secrets.
MICROSOFT_TENANT_ID=replace-with-directory-tenant-id
MICROSOFT_CLIENT_ID=replace-with-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret-value
MICROSOFT_SENDER_EMAIL=ecom@yaikh.com

# Private invoice service. Keep these server-side. Invoice creation stays off
# until this is configured; verified requests remain available for the team.
SUBSCRIPTION_INVOICE_ENABLED=false
INVOICE_SERVICE_URL=
INVOICE_SERVICE_TOKEN=

# Paid cloud subscriptions: the homepage posts a receipt only after ABA confirms
# payment. The receipt backend calculates VAT from the original KHR amount.
RECEIPT_SERVICE_URL=https://your-einvoice-host/api/v1/subscription-receipts
RECEIPT_SERVICE_TOKEN=
# Keep receipt delivery off until the EcoBoard checkout integration is approved.
SUBSCRIPTION_RECEIPTS_ENABLED=false
# Keep OTP email and invoice requests off until the invoice flow is approved.
SUBSCRIPTION_INVOICE_REQUESTS_ENABLED=false
# The receipt adapter selects the non-deleted KHR bank matching this account.
COMPANY_BANKS_SERVICE_URL=http://127.0.0.1:8000/api/v1/company-banks
COMPANY_BANKS_SERVICE_TOKEN=
COMPANY_BANK_ACCOUNT_NUMBER=015671377

# ─── AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Auth / access ──────────────────────────────────────────────────
YAI_ACCESS_CODES=
YAI_ADMIN_PASS=
YAI_COOKIE_SECRET=

# ─── Misc ───────────────────────────────────────────────────────────
#CHROME_PATH=          # headless Chrome for PDF/deck generation
