# yaikh-com — environment template.
# Copy to `.env.local` (git-ignored) and fill in real values.
#   cp .env.example .env.local

# ─── ABA PayWay (payments on /subscribe) ────────────────────────────
# Sandbox creds for merchant ec476637 live in ABA/payway-tester/.env.
# For production: request domain whitelisting from ABA, then swap in the
# production merchant id + API key and set PAYWAY_BASE_URL to the prod host.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh
# Prod:    https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Optional — only needed once Refund / pre-auth / payout flows are wired
# (RSA public key that encrypts merchant_auth). See ABA/payway-tester/.env.
#PAYWAY_RSA_PUBLIC_KEY=

# ─── Database ───────────────────────────────────────────────────────
MONGO_URL=

# ─── AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Auth / access ──────────────────────────────────────────────────
YAI_ACCESS_CODES=
YAI_ADMIN_PASS=
YAI_COOKIE_SECRET=

# ─── Misc ───────────────────────────────────────────────────────────
#CHROME_PATH=          # headless Chrome for PDF/deck generation
