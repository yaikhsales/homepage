# Copy to .env.local and fill in.
# Comma-separated CODE:label pairs. Keep the master code first.
# Codes are matched case-insensitively (and trimmed).
YAI_ACCESS_CODES="YAI2026:Master code"

# Optional: secret used to sign the auth cookie. Generate with: openssl rand -hex 32
YAI_COOKIE_SECRET="change-me-in-production-please-32-chars-min"

# --- Vertex AI: image + video generation (draws on the GCP $300 credit, NOT AI Studio) ---
# Used by scripts/generate-images.mjs and scripts/generate-videos.mjs.
# No API key — auth is your own Google login. One-time setup:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <PROJECT_ID>
#
# Project that holds your $300 credit (see the billing console URL, e.g. dauntless-arc-497605-c1):
GOOGLE_CLOUD_PROJECT=""
# Region for image models ("global" is fine for Gemini image):
GOOGLE_CLOUD_LOCATION="global"
#
# Optional image model override (default gemini-2.5-flash-image; Nano Banana Pro = gemini-3-pro-image-preview):
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
#
# Optional Veo video knobs (Veo is region-limited AND expensive — ~$0.40/sec):
# VEO_LOCATION="us-central1"
# VEO_MODEL="veo-3.1-fast-generate-preview"
# VEO_DURATION_SECONDS="8"
